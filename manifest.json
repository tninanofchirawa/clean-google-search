{
    "manifest_version": 3,
    "name": "Clean Google Search",
    "version": "2.4.0",
    "description": "Clean and distraction-free Google Search. Removes AI Overviews, sponsored ads, news carousels, and forum widgets safely.",
    "permissions": [
        "storage"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "*://google.com/search*",
                "*://*.google.com/search*",
                "*://google.co.in/search*",
                "*://*.google.co.in/search*",
                "*://google.co.uk/search*",
                "*://*.google.co.uk/search*",
                "*://google.ca/search*",
                "*://*.google.ca/search*",
                "*://google.de/search*",
                "*://*.google.de/search*",
                "*://google.fr/search*",
                "*://*.google.fr/search*",
                "*://google.com.au/search*",
                "*://*.google.com.au/search*",
                "*://google.co.jp/search*",
                "*://*.google.co.jp/search*",
                "*://google.com.br/search*",
                "*://*.google.com.br/search*",
                "*://google.es/search*",
                "*://*.google.es/search*",
                "*://google.it/search*",
                "*://*.google.it/search*",
                "*://google.nl/search*",
                "*://*.google.nl/search*",
                "*://google.com.mx/search*",
                "*://*.google.com.mx/search*",
                "*://google.co.nz/search*",
                "*://*.google.co.nz/search*",
                "*://google.ch/search*",
                "*://*.google.ch/search*",
                "*://google.se/search*",
                "*://*.google.se/search*",
                "*://google.pl/search*",
                "*://*.google.pl/search*",
                "*://google.com.sg/search*",
                "*://*.google.com.sg/search*",
                "*://google.com.hk/search*",
                "*://*.google.com.hk/search*",
                "*://google.com.tw/search*",
                "*://*.google.com.tw/search*"
            ],
            "css": [
                "content.css"
            ],
            "js": [
                "modules/config.js",
                "modules/filters.js",
                "modules/navigation.js",
                "content.js"
            ],
            "run_at": "document_start"
        }
    ]
}